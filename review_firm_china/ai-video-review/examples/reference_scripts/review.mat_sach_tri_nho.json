    {
      "id": 6,
      "narration": [
        {
          "id": "u601",
          "text": "Nghe lỏm ba bà thím buôn chuyện tưởng Tae-ha nuôi mình vì thương hại, Eun-sae tủi thân bỏ lên ủy ban xin đi nơi khác.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u602",
          "text": "Tae-ha liền phóng xe như hỏa tiễn, phi thân qua hàng rào ủy ban như vận động viên nhảy cao để giữ cô lại.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u603",
          "text": "Khi bước vào nhà thi đấu boxing nhìn bờ vai rộng của Tae-ha, ký ức tuổi học trò của Eun-sae bỗng lóe sáng.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u604",
          "text": "Hóa ra chàng trai đoạt huy chương vàng năm ấy mà cô từng thầm thương trộm nhớ lại chính là anh chàng trước mặt.",
          "emotion": "calm",
          "rate_percent": null,
          "pitch_hz": null,
