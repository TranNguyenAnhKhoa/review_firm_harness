    {
      "id": 5,
      "narration": [
        {
          "id": "u501",
          "text": "Cậu đàn em Kang-rok trốn về quê tìm đại ca, biến bữa nhậu thành thung lũng tình yêu phát cơm tró ngập mặt.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u502",
          "text": "Người ta thì cưng chiều bóc tôm đút tận mồm, còn cậu lính què thì ngồi lột tôm móng tay dính đầy vỏ thấy mà ngứa mắt.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u503",
          "text": "Eun-sae hăm hở vào bếp tập nấu kẹo mạch nha, nhưng vừa chạm tay vào nồi sôi thì nóng quá làm rơi luôn cây gáo quý của bà.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u504",
          "text": "Trong khi đó tại Seoul, ông trùm Baek Sang-gil đấm vỡ màn hình máy tính bảng khi phát hiện Tae-ha đang che giấu công tố viên.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 3600.0,
      "source_end": 5400.0,
