    {
      "id": 4,
      "narration": [
        {
          "id": "u401",
          "text": "Nhận thấy người yêu buồn chán, Tae-ha liền rủ cô lái xe máy đi hóng gió ngắm hoa anh đào.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u402",
          "text": "Vừa chạm vào tay lái, bản năng tổ lái trỗi dậy phóng vèo vèo như phim Hồng Kông khiến anh chàng ngồi sau ôm eo run bần bật.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u403",
          "text": "Tại tiệc mừng thọ tám mươi tuổi, bà nội liền đút ngay một cục kẹo mạch nha để chặn họng bà thím nhiều chuyện lại.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u404",
          "text": "Không khí xóm làng tuy ồn ào nhưng ấm áp khiến Eun-sae dần mở lòng với mái ấm nơi đây.",
          "emotion": "calm",
          "rate_percent": null,
