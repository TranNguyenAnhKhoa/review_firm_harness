    {
      "id": 2,
      "narration": [
        {
          "id": "u201",
          "text": "Giữa lúc đang lo lắng sắp bị đưa vào trung tâm bảo trợ, thì một anh chàng võ sĩ mặt mày lem luốc lù lù bước vào.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u202",
          "text": "Anh ta dõng dạc tuyên bố mình là Jang Tae-ha, bạn trai yêu nhau hai năm sắp cưới của cô.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u203",
          "text": "Lại còn tiết lộ cô vốn là thợ phụ nấu kẹo mạch nha ở xưởng kẹo của bà nội anh.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u204",
          "text": "Eun-sae chỉ biết cười trừ trong bất lực vì chưa thể thẩm thấu nổi câu chuyện cọc đi tìm trâu này.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
