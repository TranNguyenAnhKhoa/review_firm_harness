    {
      "id": 8,
      "narration": [
        {
          "id": "u801",
          "text": "Go Eun-sae danh chính ngôn thuận trở lại vai trò công tố viên, phối hợp cảnh sát giăng lưới vây bắt toàn bộ đường dây tội phạm.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u802",
          "text": "Bí mật đau lòng nhất ba mươi hai năm trước hé lộ, mẹ Tae-ha từng bế con trốn đi vì không muốn con giống người cha xã hội đen.",
          "emotion": "calm",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u803",
          "text": "Đối đầu trên đỉnh đồi, Baek Sang-gil chĩa súng vào đầu Tae-ha nhưng chợt nhận ra con trai cũng có thói quen ăn món canh tương ớt giống mình.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u804",
          "text": "Trong phút hối hận muộn màng, ông trùm buông tay đẩy con trai ra rồi tự kết liễu đời mình để chấm dứt mối nghiệp duyên.",
          "emotion": "serious",
