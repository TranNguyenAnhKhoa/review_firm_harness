    {
      "id": 7,
      "narration": [
        {
          "id": "u701",
          "text": "Sóng gió ập đến khi băng đảng Baek Sang-gil dẫn quân bao vây làng quê truy cùng đuổi tận.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u702",
          "text": "Tae-ha đưa Eun-sae lên cano thoát thân, còn mình một mình ở lại đối đầu với biển lửa bến cảng.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u703",
          "text": "Chấn động từ vụ nổ kinh hoàng kích hoạt tế bào thần kinh, giúp toàn bộ ký ức công tố viên Go Ji-won ùa về trong đầu cô.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u704",
          "text": "Để trả thù, đám giang hồ chặn đường hầm tông xe dã man khiến người chị thân thiết của Tae-ha nguy kịch tính mạng.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
