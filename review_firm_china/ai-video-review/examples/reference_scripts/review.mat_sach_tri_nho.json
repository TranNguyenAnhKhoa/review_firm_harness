      "narration": [
        {
          "id": "u101",
          "text": "Vừa mở mắt tỉnh dậy trong bệnh viện, cô nàng đã được bác sĩ tặng ngay một combo sét đánh ngang tai.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u102",
          "text": "Mất trí nhớ phân ly, không tên tuổi, không nghề nghiệp và ngay cả dấu vân tay cũng bay màu luôn.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u103",
          "text": "Sau đó cô nàng nhìn vào gương tự khen hàng họ ok phết, có cơ bụng thế này sao không vào showbiz luôn đi.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u104",
          "text": "Nghe mấy bà bác xúi đập đầu vào tường để kích hoạt lại trí nhớ, cô nàng liền lấy đà đập trán côm cốp rồi lăn đùng ra ngất xỉu lần hai.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 0.0,
      "source_end": 160.0,
      "visual_intent": "Tai nạn, mất trí nhớ và pha tự kích hoạt bộ nhớ đi vào lòng đất",
      "target_duration": null,
