    {
      "id": 3,
      "narration": [
        {
          "id": "u301",
          "text": "Về quê chưa được bao lâu, cô nàng liền lén đi khám tâm thần để tìm lại lai lịch.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u302",
          "text": "Gặp anh viện trưởng định ga-lăng xoay người một trăm tám mươi độ che mưa nhưng làm lố thành compa ba trăm sáu mươi độ hắt ướt sũng người.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u303",
          "text": "Đã vậy Tae-ha ở nhà còn cặm cụi vẽ ba quả táo dặn người yêu ăn đủ ba bữa như chăm em bé.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u304",
          "text": "Ngay cả bà thầy bói khét tiếng cũng phải muối mặt đến tận nhà trả lại tiền quẻ vì phán trật lất.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
