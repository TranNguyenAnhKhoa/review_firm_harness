{
  "title": "Gả Kim Thoa Tập 1 — Kèo Thơm Xung Hỷ Và Cú Lội Ngược Dòng Của Nàng Đổ Dạ Hương",
  "source_video": "input/videos/ga_kim_thoa_ep01.mp4",
  "segments": [
    {
      "id": 1,
      "narration": [
        {
          "id": "u1_1",
          "text": "Vừa mở màn, Gả Kim Thoa đã ném khán giả vào ngay không khí xa hoa nhưng đầy toan tính của Thừa An Bá phủ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u1_2",
          "text": "Tại đây, nhị tiểu thư Quân Đại đang ngồi trước gương đồng, tay mân mê chiếc trâm vàng nạm ngọc với vẻ mặt vô cùng đắc ý.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u1_3",
          "text": "Cứ ngỡ nàng ta sắp được gả vào hào môn danh giá nhất kinh thành để hưởng vinh hoa phú quý trọn đời.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 0.0,
      "source_end": 44.53,
      "visual_intent": "Diễn biến tập 1 đoạn 0s-45s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1.0,
          "source_end": 13.76,
          "weight": 1.0,
          "speech_unit_id": "u1_1"
        },
        {
          "source_start": 15.18,
          "source_end": 27.94,
          "weight": 1.0,
          "speech_unit_id": "u1_2"
        },
        {
          "source_start": 29.35,
          "source_end": 42.11,
          "weight": 1.0,
          "speech_unit_id": "u1_3"
        }
      ]
    },
    {
      "id": 2,
      "narration": [
        {
          "id": "u2_1",
          "text": "Nhưng đời đúng là không như là mơ, tin tức từ tiền sảnh truyền vào khiến nụ cười trên môi tiểu thư tắt ngúm trong một nốt nhạc.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u2_2",
          "text": "Hôn ước từ nhỏ của nàng đúng là danh giá thật, đối tượng chính là Lục Trạc, thế tử phủ Anh Quốc Công lừng lẫy.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u2_3",
          "text": "Ngặt nỗi chàng thế tử vừa đánh trận trở về thì trúng tên độc, hiện đang nằm bất tỉnh nhân sự, hơi thở thoi thóp như ngọn đèn trước gió.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 44.53,
      "source_end": 89.06,
      "visual_intent": "Diễn biến tập 1 đoạn 45s-89s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 45.53,
          "source_end": 58.29,
          "weight": 1.0,
          "speech_unit_id": "u2_1"
        },
        {
          "source_start": 59.71,
          "source_end": 72.47,
          "weight": 1.0,
          "speech_unit_id": "u2_2"
        },
        {
          "source_start": 73.88,
          "source_end": 86.64,
          "weight": 1.0,
          "speech_unit_id": "u2_3"
        }
      ]
    },
    {
      "id": 3,
      "narration": [
        {
          "id": "u3_1",
          "text": "Phủ Anh Quốc Công thấy con trai sắp đi gặp diêm vương liền nảy ra sáng kiến tổ chức đám cưới gấp để xung hỷ trừ tà.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u3_2",
          "text": "Nói trắng ra là muốn rước Quân Đại về để nếu thế tử có mệnh hệ nào thì nàng sẽ trở thành góa phụ giữ trinh tiết cả đời.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u3_3",
          "text": "Tiểu thư kiêu kỳ nghe xong thì giãy nảy như đỉa phải vôi, một mực từ chối bước chân vào nấm mồ hôn nhân định mệnh này.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 89.06,
      "source_end": 133.59,
      "visual_intent": "Diễn biến tập 1 đoạn 89s-134s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 90.06,
          "source_end": 102.82,
          "weight": 1.0,
          "speech_unit_id": "u3_1"
        },
        {
          "source_start": 104.24,
          "source_end": 117.0,
          "weight": 1.0,
          "speech_unit_id": "u3_2"
        },
        {
          "source_start": 118.41,
          "source_end": 131.17,
          "weight": 1.0,
          "speech_unit_id": "u3_3"
        }
      ]
    },
    {
      "id": 4,
      "narration": [
        {
          "id": "u4_1",
          "text": "Nàng gào thét trong phòng, đập phá đồ đạc và tuyên bố thẳng thừng rằng thà làm ni cô chứ quyết không lấy một khúc gỗ mục.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u4_2",
          "text": "Thế nhưng hôn ước là do Lão tổ tông và triều đình định đoạt, đâu phải thứ muốn quỵt là quỵt được dễ dàng như ăn kẹo.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u4_3",
          "text": "Trong lúc tranh cãi nảy lửa với tỳ nữ thân cận, chiếc trâm cài tóc đắt giá bất ngờ rơi xuống sàn gạch lạnh lẽo.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 133.59,
      "source_end": 178.12,
      "visual_intent": "Diễn biến tập 1 đoạn 134s-178s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 134.59,
          "source_end": 147.35,
          "weight": 1.0,
          "speech_unit_id": "u4_1"
        },
        {
          "source_start": 148.77,
          "source_end": 161.53,
          "weight": 1.0,
          "speech_unit_id": "u4_2"
        },
        {
          "source_start": 162.94,
          "source_end": 175.7,
          "weight": 1.0,
          "speech_unit_id": "u4_3"
        }
      ]
    },
    {
      "id": 5,
      "narration": [
        {
          "id": "u5_1",
          "text": "Đầu trâm sắc nhọn vấy lên một vệt máu đỏ tươi, báo hiệu chuỗi sóng gió quyền mưu kinh thiên động địa sắp sửa ập đến.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u5_2",
          "text": "Bị dồn vào chân tường, Quân Đại bắt đầu vận dụng hết công suất chất xám trong đầu để tìm đường thoát thân cho bằng được.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u5_3",
          "text": "Và rồi, một kế hoạch tráo mận đổi đào điên rồ nhất chốn kinh kỳ đã được nàng ta âm thầm vạch ra trong bóng tối.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 178.12,
      "source_end": 222.66,
      "visual_intent": "Diễn biến tập 1 đoạn 178s-223s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 179.12,
          "source_end": 191.88,
          "weight": 1.0,
          "speech_unit_id": "u5_1"
        },
        {
          "source_start": 193.3,
          "source_end": 206.06,
          "weight": 1.0,
          "speech_unit_id": "u5_2"
        },
        {
          "source_start": 207.48,
          "source_end": 220.24,
          "weight": 1.0,
          "speech_unit_id": "u5_3"
        }
      ]
    },
    {
      "id": 6,
      "narration": [
        {
          "id": "u6_1",
          "text": "Rời khỏi khu phủ đệ nguy nga, ống kính máy quay lập tức chuyển cảnh sang một góc ngõ hẻm nghèo nàn và lầy lội ở ngoại thành.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u6_2",
          "text": "Tại đây, một cô gái trẻ trong bộ đồ vải thô rách rưới đang còng lưng gánh từng thùng dạ hương nặng trĩu đi đổ thuê kiếm sống.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u6_3",
          "text": "Dù mặt mũi lấm lem bùn đất và phải làm công việc bần hàn nhất thiên hạ, nhưng đôi mắt của cô gái vẫn sáng ngời và tràn đầy nghị lực.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 222.66,
      "source_end": 267.19,
      "visual_intent": "Diễn biến tập 1 đoạn 223s-267s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 223.66,
          "source_end": 236.42,
          "weight": 1.0,
          "speech_unit_id": "u6_1"
        },
        {
          "source_start": 237.84,
          "source_end": 250.6,
          "weight": 1.0,
          "speech_unit_id": "u6_2"
        },
        {
          "source_start": 252.01,
          "source_end": 264.77,
          "weight": 1.0,
          "speech_unit_id": "u6_3"
        }
      ]
    },
    {
      "id": 7,
      "narration": [
        {
          "id": "u7_1",
          "text": "Cô nàng này tên gọi là A Sửu, cái tên xấu xí người ta đặt cho để dễ nuôi, nhưng thực chất dung mạo ẩn sau lớp nhọ nồi lại là một tuyệt sắc giai nhân.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u7_2",
          "text": "Điều kỳ lạ hơn nữa là nếu rửa sạch mặt, A Sửu sở hữu ngũ quan giống nhị tiểu thư Quân Đại như hai giọt nước đúc ra từ một khuôn.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u7_3",
          "text": "Khán giả xem phim đến đây là ngửi thấy mùi thân thế tráo con từ thuở lọt lòng quen thuộc của phim gia đấu rồi.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 267.19,
      "source_end": 311.72,
      "visual_intent": "Diễn biến tập 1 đoạn 267s-312s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 268.19,
          "source_end": 280.95,
          "weight": 1.0,
          "speech_unit_id": "u7_1"
        },
        {
          "source_start": 282.37,
          "source_end": 295.13,
          "weight": 1.0,
          "speech_unit_id": "u7_2"
        },
        {
          "source_start": 296.54,
          "source_end": 309.3,
          "weight": 1.0,
          "speech_unit_id": "u7_3"
        }
      ]
    },
    {
      "id": 8,
      "narration": [
        {
          "id": "u8_1",
          "text": "A Sửu cày ngày cày đêm không phải vì đam mê lao động công ích, mà vì người mẹ nuôi đang mắc bạo bệnh nằm liệt giường trong túp lều rách nát.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u8_2",
          "text": "Tiền thuốc men mỗi ngày như muối bỏ bể, chủ tiệm thuốc liên tục đòi nợ khiến hai mẹ con rơi vào bước đường cùng không lối thoát.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u8_3",
          "text": "Đúng lúc tuyệt vọng nhất thì một cỗ xe ngựa sang trọng bất ngờ dừng lại ngay trước đầu con hẻm ổ chuột hôi hám.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 311.72,
      "source_end": 356.25,
      "visual_intent": "Diễn biến tập 1 đoạn 312s-356s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 312.72,
          "source_end": 325.48,
          "weight": 1.0,
          "speech_unit_id": "u8_1"
        },
        {
          "source_start": 326.9,
          "source_end": 339.66,
          "weight": 1.0,
          "speech_unit_id": "u8_2"
        },
        {
          "source_start": 341.07,
          "source_end": 353.83,
          "weight": 1.0,
          "speech_unit_id": "u8_3"
        }
      ]
    },
    {
      "id": 9,
      "narration": [
        {
          "id": "u9_1",
          "text": "Quân Đại bước xuống xe, che mũi nhìn quanh với vẻ khinh bỉ tột cùng, nhưng khi nhìn thẳng vào mặt A Sửu thì ả ta chết trân tại chỗ.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u9_2",
          "text": "Sự giống nhau đến rợn người giữa hai số phận đối nghịch đã chứng minh cho ả thấy rằng chiếc phao cứu sinh của đời mình đã xuất hiện.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u9_3",
          "text": "Quân Đại lập tức cho người đuổi hết dân tình xung quanh rồi kéo A Sửu vào căn nhà tranh dột nát để bàn chuyện làm ăn lớn.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 356.25,
      "source_end": 400.78,
      "visual_intent": "Diễn biến tập 1 đoạn 356s-401s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 357.25,
          "source_end": 370.01,
          "weight": 1.0,
          "speech_unit_id": "u9_1"
        },
        {
          "source_start": 371.43,
          "source_end": 384.19,
          "weight": 1.0,
          "speech_unit_id": "u9_2"
        },
        {
          "source_start": 385.6,
          "source_end": 398.36,
          "weight": 1.0,
          "speech_unit_id": "u9_3"
        }
      ]
    },
    {
      "id": 10,
      "narration": [
        {
          "id": "u10_1",
          "text": "Không vòng vo tam quốc, nàng thiên kim ném ngay một bọc bạc trắng lấp lánh lên chiếc bàn gỗ ọp ẹp trước sự ngỡ ngàng của cô gái nghèo.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u10_2",
          "text": "Bảo rằng chỉ cần A Sửu chịu đóng giả làm nhị tiểu thư bước lên kiệu hoa gả sang phủ Anh Quốc Công xung hỷ, tiền thuốc thang cho mẹ sẽ được lo trọn đời.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u10_3",
          "text": "Ngược lại, nếu dám từ chối hoặc để lộ nửa lời, cả hai mẹ con sẽ không còn đất dung thân ở cái kinh thành đầy cạm bẫy này.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 400.78,
      "source_end": 445.31,
      "visual_intent": "Diễn biến tập 1 đoạn 401s-445s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 401.78,
          "source_end": 414.54,
          "weight": 1.0,
          "speech_unit_id": "u10_1"
        },
        {
          "source_start": 415.96,
          "source_end": 428.72,
          "weight": 1.0,
          "speech_unit_id": "u10_2"
        },
        {
          "source_start": 430.13,
          "source_end": 442.89,
          "weight": 1.0,
          "speech_unit_id": "u10_3"
        }
      ]
    },
    {
      "id": 11,
      "narration": [
        {
          "id": "u11_1",
          "text": "A Sửu cầm thỏi bạc trên tay mà lòng nặng trĩu như đeo đá, nàng thừa hiểu bước chân vào chốn hào môn xung hỷ chẳng khác nào nhảy vào miệng cọp.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u11_2",
          "text": "Nhưng nhìn mẹ nuôi đang ho sặc sụa từng cơn trên manh chiếu rách, nàng biết mình không còn bất kỳ sự lựa chọn nào khác ngoài việc đánh cược mạng sống.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u11_3",
          "text": "Nàng ngẩng cao đầu đồng ý nhận lời giao dịch, mở ra bước ngoặt đổi đời đầy chông gai và hiểm họa khôn lường.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 445.31,
      "source_end": 489.84,
      "visual_intent": "Diễn biến tập 1 đoạn 445s-490s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 446.31,
          "source_end": 459.07,
          "weight": 1.0,
          "speech_unit_id": "u11_1"
        },
        {
          "source_start": 460.49,
          "source_end": 473.25,
          "weight": 1.0,
          "speech_unit_id": "u11_2"
        },
        {
          "source_start": 474.66,
          "source_end": 487.42,
          "weight": 1.0,
          "speech_unit_id": "u11_3"
        }
      ]
    },
    {
      "id": 12,
      "narration": [
        {
          "id": "u12_1",
          "text": "Màn đêm buông xuống, một cỗ xe ngựa bí mật đưa A Sửu luồn qua cửa sau để tiến vào nội viện Thừa An Bá phủ.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u12_2",
          "text": "Vừa cởi bỏ bộ đồ thô kệch và tắm rửa sạch sẽ, dung nhan thực sự của nàng lộ ra khiến ngay cả tỳ nữ thân cận của Quân Đại cũng phải giật mình thảng thốt.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u12_3",
          "text": "Quân Đại đứng cạnh nhìn bản sao của mình mà vừa mừng vừa sợ, trong lòng dấy lên nỗi ghen ghét khó tả trước nét đẹp thanh thuần của đối phương.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 489.84,
      "source_end": 534.38,
      "visual_intent": "Diễn biến tập 1 đoạn 490s-534s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 490.84,
          "source_end": 503.6,
          "weight": 1.0,
          "speech_unit_id": "u12_1"
        },
        {
          "source_start": 505.02,
          "source_end": 517.78,
          "weight": 1.0,
          "speech_unit_id": "u12_2"
        },
        {
          "source_start": 519.2,
          "source_end": 531.96,
          "weight": 1.0,
          "speech_unit_id": "u12_3"
        }
      ]
    },
    {
      "id": 13,
      "narration": [
        {
          "id": "u13_1",
          "text": "Khóa huấn luyện cấp tốc mang tên biến quạ thành công chính thức được kích hoạt ngay trong đêm tối tĩnh mịch.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u13_2",
          "text": "Một cô gái quen gánh phân bước đi thoăn thoắt giờ đây bị bắt học cách đi đứng nhẹ nhàng như hoa sen lướt trên mặt nước.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u13_3",
          "text": "Đầu đội bát nước đầy, lưng buộc thanh nẹp gỗ, hễ làm sánh ra một giọt là tỳ nữ lập tức dùng thước kẻ gõ vào tay cảnh cáo không thương tiếc.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 534.38,
      "source_end": 578.91,
      "visual_intent": "Diễn biến tập 1 đoạn 534s-579s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 535.38,
          "source_end": 548.14,
          "weight": 1.0,
          "speech_unit_id": "u13_1"
        },
        {
          "source_start": 549.56,
          "source_end": 562.32,
          "weight": 1.0,
          "speech_unit_id": "u13_2"
        },
        {
          "source_start": 563.73,
          "source_end": 576.49,
          "weight": 1.0,
          "speech_unit_id": "u13_3"
        }
      ]
    },
    {
      "id": 14,
      "narration": [
        {
          "id": "u14_1",
          "text": "Thế nhưng điều khiến Quân Đại bất ngờ nhất là A Sửu học cực kỳ nhanh, ngón tay búp măng cầm quạt che mặt duyên dáng đến lạ kỳ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u14_2",
          "text": "Từng dáng đi, nụ cười hé môi cho đến cái liếc mắt đưa tình của quý tộc đều được nàng tiếp thu và bắt chước chuẩn xác đến từng milimét.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u14_3",
          "text": "Dường như khí chất cao quý vốn đã nằm sẵn trong máu của nàng từ kiếp nào, chỉ chờ dịp này là bùng phát mạnh mẽ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 578.91,
      "source_end": 623.44,
      "visual_intent": "Diễn biến tập 1 đoạn 579s-623s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 579.91,
          "source_end": 592.67,
          "weight": 1.0,
          "speech_unit_id": "u14_1"
        },
        {
          "source_start": 594.09,
          "source_end": 606.85,
          "weight": 1.0,
          "speech_unit_id": "u14_2"
        },
        {
          "source_start": 608.26,
          "source_end": 621.02,
          "weight": 1.0,
          "speech_unit_id": "u14_3"
        }
      ]
    },
    {
      "id": 15,
      "narration": [
        {
          "id": "u15_1",
          "text": "Bên cạnh việc luyện hình thể, Quân Đại còn bắt A Sửu học thuộc lòng gia phả, tính cách và các mối quan hệ phức tạp trong gia đình quyền quý.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u15_2",
          "text": "Từ sở thích uống trà của Lão tổ tông cho đến tật xấu hay soi mói của các vị phu nhân đều phải ghi nhớ vanh vách không được phép sai một chữ.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u15_3",
          "text": "Bởi vì trong chốn hậu viện thâm sâu, chỉ cần sơ sẩy lộ ra một thói quen bần hàn là đầu sẽ rơi xuống đất ngay tức khắc.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 623.44,
      "source_end": 667.97,
      "visual_intent": "Diễn biến tập 1 đoạn 623s-668s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 624.44,
          "source_end": 637.2,
          "weight": 1.0,
          "speech_unit_id": "u15_1"
        },
        {
          "source_start": 638.62,
          "source_end": 651.38,
          "weight": 1.0,
          "speech_unit_id": "u15_2"
        },
        {
          "source_start": 652.79,
          "source_end": 665.55,
          "weight": 1.0,
          "speech_unit_id": "u15_3"
        }
      ]
    },
    {
      "id": 16,
      "narration": [
        {
          "id": "u16_1",
          "text": "Trong lúc tập luyện dâng trà, tỳ nữ vô tình phát hiện trên cánh tay A Sửu có một vết sẹo dài do thời thơ ấu lao động vất vả để lại.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u16_2",
          "text": "Quân Đại hoảng hốt nhận ra tay tiểu thư lá ngọc cành vàng mịn màng không tì vết, nếu đêm tân hôn bị nhà trai thấy vết sẹo này thì lộ tẩy chắc chắn.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u16_3",
          "text": "Ả ta lập tức sai người mang bột phấn ngọc trai và cao mờ sẹo hảo hạng đến bôi trát nhiều lớp nhằm ngụy trang hoàn hảo vết tích.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 667.97,
      "source_end": 712.5,
      "visual_intent": "Diễn biến tập 1 đoạn 668s-712s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 668.97,
          "source_end": 681.73,
          "weight": 1.0,
          "speech_unit_id": "u16_1"
        },
        {
          "source_start": 683.15,
          "source_end": 695.91,
          "weight": 1.0,
          "speech_unit_id": "u16_2"
        },
        {
          "source_start": 697.32,
          "source_end": 710.08,
          "weight": 1.0,
          "speech_unit_id": "u16_3"
        }
      ]
    },
    {
      "id": 17,
      "narration": [
        {
          "id": "u17_1",
          "text": "A Sửu cắn răng chịu đựng cảm giác xót rát khi lớp thuốc bôi lên da thịt mà không hề kêu ca lấy một tiếng nào.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u17_2",
          "text": "Sự bình tĩnh và ánh mắt kiên định của cô gái nghèo khiến đám gia nhân phục vụ bên cạnh bắt đầu có cái nhìn nể phục từ tận đáy lòng.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u17_3",
          "text": "Nàng hiểu rằng đây không chỉ là màn kịch gả thay, mà còn là cơ hội duy nhất để nàng thoát khỏi kiếp bùn đen tăm tối.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 712.5,
      "source_end": 757.03,
      "visual_intent": "Diễn biến tập 1 đoạn 712s-757s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 713.5,
          "source_end": 726.26,
          "weight": 1.0,
          "speech_unit_id": "u17_1"
        },
        {
          "source_start": 727.68,
          "source_end": 740.44,
          "weight": 1.0,
          "speech_unit_id": "u17_2"
        },
        {
          "source_start": 741.85,
          "source_end": 754.61,
          "weight": 1.0,
          "speech_unit_id": "u17_3"
        }
      ]
    },
    {
      "id": 18,
      "narration": [
        {
          "id": "u18_1",
          "text": "Sáng hôm sau, tiếng chuông báo hiệu giờ thỉnh an vang lên khắp các dãy hành lang rợp bóng cây cổ thụ của Thừa An Bá phủ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u18_2",
          "text": "Đây chính là bài thi sát hạch quan trọng đầu tiên: A Sửu phải diện kiến Lão tổ tông và mẫu thân trước khi chính thức bước lên kiệu hoa.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u18_3",
          "text": "Quân Đại đứng nấp sau tấm bình phong hoa điểu, mồ hôi ướt đẫm trán vì lo sợ kế hoạch tráo người bị bại lộ giữa ban ngày ban mặt.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 757.03,
      "source_end": 801.56,
      "visual_intent": "Diễn biến tập 1 đoạn 757s-802s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 758.03,
          "source_end": 770.79,
          "weight": 1.0,
          "speech_unit_id": "u18_1"
        },
        {
          "source_start": 772.21,
          "source_end": 784.97,
          "weight": 1.0,
          "speech_unit_id": "u18_2"
        },
        {
          "source_start": 786.38,
          "source_end": 799.14,
          "weight": 1.0,
          "speech_unit_id": "u18_3"
        }
      ]
    },
    {
      "id": 19,
      "narration": [
        {
          "id": "u19_1",
          "text": "A Sửu khoác lên mình bộ gấm hoa lộng lẫy, đầu cài trâm ngọc buông rủ, từng bước chân uyển chuyển tiến vào đại sảnh như một nàng tiên giáng trần.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u19_2",
          "text": "Điệu bộ đoan trang lễ phép, lời nói dạ vâng nhỏ nhẹ khiến các ma ma khó tính nhất trong phủ cũng phải gật gù khen ngợi tấm tắc.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u19_3",
          "text": "Quân Đại nấp bên trong nhìn ra mà tức anh ách, tự hỏi không biết đứa con gái đổ dạ hương này có uống nhầm thần dược quý tộc hay không.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 801.56,
      "source_end": 846.09,
      "visual_intent": "Diễn biến tập 1 đoạn 802s-846s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 802.56,
          "source_end": 815.32,
          "weight": 1.0,
          "speech_unit_id": "u19_1"
        },
        {
          "source_start": 816.74,
          "source_end": 829.5,
          "weight": 1.0,
          "speech_unit_id": "u19_2"
        },
        {
          "source_start": 830.91,
          "source_end": 843.67,
          "weight": 1.0,
          "speech_unit_id": "u19_3"
        }
      ]
    },
    {
      "id": 20,
      "narration": [
        {
          "id": "u20_1",
          "text": "Lão phu nhân ngồi trên ghế bọc nhung khẽ nhấp ngụm trà sen, đôi mắt tinh đời nheo lại quan sát từng cử chỉ của đứa cháu gái yêu quý.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u20_2",
          "text": "Bà cụ đột nhiên gọi A Sửu lại gần rồi nắm lấy bàn tay nàng, nhẹ nhàng hỏi han về cảm xúc trước ngày đại hôn xuất giá.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u20_3",
          "text": "Không khí trong sảnh bỗng chốc đông cứng lại, ai nấy đều nín thở chờ đợi xem liệu có điều gì bất thường bị phát hiện hay không.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 846.09,
      "source_end": 890.62,
      "visual_intent": "Diễn biến tập 1 đoạn 846s-891s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 847.09,
          "source_end": 859.85,
          "weight": 1.0,
          "speech_unit_id": "u20_1"
        },
        {
          "source_start": 861.27,
          "source_end": 874.03,
          "weight": 1.0,
          "speech_unit_id": "u20_2"
        },
        {
          "source_start": 875.44,
          "source_end": 888.2,
          "weight": 1.0,
          "speech_unit_id": "u20_3"
        }
      ]
    },
    {
      "id": 21,
      "narration": [
        {
          "id": "u21_1",
          "text": "Bằng sự thông minh trời phú, A Sửu khéo léo đáp rằng được gả cho thế tử Anh Quốc Công là phúc phận lớn của đời mình và của cả dòng tộc.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u21_2",
          "text": "Dù phu quân có đang bệnh nặng, nàng nguyện toàn tâm toàn ý chăm sóc ngày đêm, một lòng vì gia môn mà không hề oán thán nửa lời.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u21_3",
          "text": "Câu trả lời thấu tình đạt lý, vừa giữ trọn đạo hiếu vừa thể hiện khí chất đại gia đình khiến Lão phu nhân vô cùng xúc động và hài lòng.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 890.62,
      "source_end": 935.16,
      "visual_intent": "Diễn biến tập 1 đoạn 891s-935s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 891.62,
          "source_end": 904.38,
          "weight": 1.0,
          "speech_unit_id": "u21_1"
        },
        {
          "source_start": 905.8,
          "source_end": 918.56,
          "weight": 1.0,
          "speech_unit_id": "u21_2"
        },
        {
          "source_start": 919.98,
          "source_end": 932.74,
          "weight": 1.0,
          "speech_unit_id": "u21_3"
        }
      ]
    },
    {
      "id": 22,
      "narration": [
        {
          "id": "u22_1",
          "text": "Lão tổ tông liền tháo ngay chiếc vòng ngọc bích gia truyền đeo vào cổ tay nàng, tuyên bố trước toàn thể gia quyến về của hồi môn mười dặm.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u22_2",
          "text": "Bảo rằng Thừa An Bá phủ tuyệt đối không để con cháu mình chịu thiệt thòi khi bước chân vào cửa nhà người khác, của cải mang theo sẽ trải dài mười dặm hồng trang.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u22_3",
          "text": "A Sửu quỳ lạy tạ ơn, trong lòng thầm nhủ phen này liều mạng đi làm dâu hào môn coi bộ cũng có thu hoạch bất ngờ ngoài mong đợi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 935.16,
      "source_end": 979.69,
      "visual_intent": "Diễn biến tập 1 đoạn 935s-980s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 936.16,
          "source_end": 948.92,
          "weight": 1.0,
          "speech_unit_id": "u22_1"
        },
        {
          "source_start": 950.34,
          "source_end": 963.1,
          "weight": 1.0,
          "speech_unit_id": "u22_2"
        },
        {
          "source_start": 964.51,
          "source_end": 977.27,
          "weight": 1.0,
          "speech_unit_id": "u22_3"
        }
      ]
    },
    {
      "id": 23,
      "narration": [
        {
          "id": "u23_1",
          "text": "Trái ngược với niềm hân hoan của Lão phu nhân, Bá phu nhân ngồi bên cạnh lại có biểu cảm vô cùng gượng gạo và bất an.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u23_2",
          "text": "Ánh mắt bà ta nhìn A Sửu chứa chan nỗi bàng hoàng lẫn xót xa, bàn tay lần tràng hạt run rẩy không ngừng phát ra tiếng lách cách.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u23_3",
          "text": "Dường như trong sâu thẳm tâm can, người đàn bà này đang che giấu một bí mật tội lỗi khủng khiếp liên quan đến thân thế thật sự của hai đứa trẻ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 979.69,
      "source_end": 1024.22,
      "visual_intent": "Diễn biến tập 1 đoạn 980s-1024s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 980.69,
          "source_end": 993.45,
          "weight": 1.0,
          "speech_unit_id": "u23_1"
        },
        {
          "source_start": 994.87,
          "source_end": 1007.63,
          "weight": 1.0,
          "speech_unit_id": "u23_2"
        },
        {
          "source_start": 1009.04,
          "source_end": 1021.8,
          "weight": 1.0,
          "speech_unit_id": "u23_3"
        }
      ]
    },
    {
      "id": 24,
      "narration": [
        {
          "id": "u24_1",
          "text": "Sau buổi thỉnh an, Bá phu nhân kéo Quân Đại vào phòng kín tra hỏi gắt gao về nguồn gốc thực sự của cô gái đang đóng giả tiểu thư.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u24_2",
          "text": "Quân Đại bực bội gạt phắt đi, bảo rằng mẹ chỉ cần biết con gái ruột của mẹ không phải đi làm góa phụ chịu khổ là được rồi.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u24_3",
          "text": "Ả ta còn dằn mặt mẹ mình không được can thiệp vào chuyện này, nếu phá hỏng kế hoạch thì cả phủ sẽ phải gánh tội khi quân lừa dối hoàng gia.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1024.22,
      "source_end": 1068.75,
      "visual_intent": "Diễn biến tập 1 đoạn 1024s-1069s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1025.22,
          "source_end": 1037.98,
          "weight": 1.0,
          "speech_unit_id": "u24_1"
        },
        {
          "source_start": 1039.4,
          "source_end": 1052.16,
          "weight": 1.0,
          "speech_unit_id": "u24_2"
        },
        {
          "source_start": 1053.57,
          "source_end": 1066.33,
          "weight": 1.0,
          "speech_unit_id": "u24_3"
        }
      ]
    },
    {
      "id": 25,
      "narration": [
        {
          "id": "u25_1",
          "text": "Bá phu nhân rơi nước mắt nghẹn ngào thốt lên rằng nếu có nhân quả báo ứng thì gia đình này sẽ gánh chịu muôn đời muôn kiếp.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u25_2",
          "text": "Quân Đại cười khẩy đáp lại rằng trên đời này làm gì có nhân quả, kẻ nào nắm được quyền lực và vàng bạc thì kẻ đó mới là chân lý sống.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u25_3",
          "text": "Đúng là tư duy của nhân vật phản diện điển hình, càng tự tin bao nhiêu thì sau này nghiệp quật sẽ càng đau đớn bấy nhiêu.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1068.75,
      "source_end": 1113.28,
      "visual_intent": "Diễn biến tập 1 đoạn 1069s-1113s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1069.75,
          "source_end": 1082.51,
          "weight": 1.0,
          "speech_unit_id": "u25_1"
        },
        {
          "source_start": 1083.93,
          "source_end": 1096.69,
          "weight": 1.0,
          "speech_unit_id": "u25_2"
        },
        {
          "source_start": 1098.1,
          "source_end": 1110.86,
          "weight": 1.0,
          "speech_unit_id": "u25_3"
        }
      ]
    },
    {
      "id": 26,
      "narration": [
        {
          "id": "u26_1",
          "text": "Thời gian thấm thoát trôi qua, ngày lành tháng tốt tổ chức hôn lễ xung hỷ cuối cùng cũng đã điểm trên tấm lịch treo tường.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u26_2",
          "text": "Cả Thừa An Bá phủ giăng đèn kết hoa đỏ rực rỡ, tiếng chiêng trống nhạc hỷ vang vọng khắp các ngõ phố trung tâm kinh thành náo nhiệt.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u26_3",
          "text": "Bên trong khuê phòng, A Sửu đang được các bà mối và cung nữ kỳ cựu trang điểm chải chuốt cẩn thận từng lọn tóc mượt mà.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1113.28,
      "source_end": 1157.81,
      "visual_intent": "Diễn biến tập 1 đoạn 1113s-1158s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1114.28,
          "source_end": 1127.04,
          "weight": 1.0,
          "speech_unit_id": "u26_1"
        },
        {
          "source_start": 1128.46,
          "source_end": 1141.22,
          "weight": 1.0,
          "speech_unit_id": "u26_2"
        },
        {
          "source_start": 1142.63,
          "source_end": 1155.39,
          "weight": 1.0,
          "speech_unit_id": "u26_3"
        }
      ]
    },
    {
      "id": 27,
      "narration": [
        {
          "id": "u27_1",
          "text": "Bộ giá y màu đỏ son thêu hoa văn chim phượng bằng chỉ vàng lộng lẫy ôm trọn lấy vóc dáng thon thả kiều diễm của nàng tân nương.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u27_2",
          "text": "Khuôn mặt được dặm phấn thoa son tinh tế, làm nổi bật đôi mắt phượng sắc sảo và làn môi son quyến rũ hút hồn người đối diện.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u27_3",
          "text": "Đến lúc này, không còn ai có thể nhận ra bóng dáng của một cô gái nghèo từng lam lũ mưu sinh nơi ngõ hẻm lầy lội ngày nào.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1157.81,
      "source_end": 1202.34,
      "visual_intent": "Diễn biến tập 1 đoạn 1158s-1202s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1158.81,
          "source_end": 1171.57,
          "weight": 1.0,
          "speech_unit_id": "u27_1"
        },
        {
          "source_start": 1172.99,
          "source_end": 1185.75,
          "weight": 1.0,
          "speech_unit_id": "u27_2"
        },
        {
          "source_start": 1187.16,
          "source_end": 1199.92,
          "weight": 1.0,
          "speech_unit_id": "u27_3"
        }
      ]
    },
    {
      "id": 28,
      "narration": [
        {
          "id": "u28_1",
          "text": "Quân Đại đứng bên cạnh nhìn ngắm bản sao hoàn mỹ của mình mà trong lòng dâng trào muôn vàn cảm xúc hỗn độn khó tả.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u28_2",
          "text": "Ả tiến lại gần, tự tay chỉnh lại chiếc khăn trùm đầu màu đỏ thêu hoa sen rồi ghé sát vào tai A Sửu thì thầm những lời đe dọa sắc lạnh.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u28_3",
          "text": "Bảo rằng khi bước qua cánh cổng phủ Anh Quốc Công, sống hay chết đều phụ thuộc vào sự kín miệng và ngoan ngoãn của nàng.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1202.34,
      "source_end": 1246.88,
      "visual_intent": "Diễn biến tập 1 đoạn 1202s-1247s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1203.34,
          "source_end": 1216.1,
          "weight": 1.0,
          "speech_unit_id": "u28_1"
        },
        {
          "source_start": 1217.52,
          "source_end": 1230.28,
          "weight": 1.0,
          "speech_unit_id": "u28_2"
        },
        {
          "source_start": 1231.7,
          "source_end": 1244.46,
          "weight": 1.0,
          "speech_unit_id": "u28_3"
        }
      ]
    },
    {
      "id": 29,
      "narration": [
        {
          "id": "u29_1",
          "text": "A Sửu khẽ mỉm cười đáp lễ, ánh mắt không hề nao núng hay sợ hãi trước sự uy hiếp của nàng tiểu thư kênh kiệu độc ác.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u29_2",
          "text": "Nàng bình thản nhắc nhở Quân Đại hãy nhớ giữ đúng lời hứa gửi thuốc thang và tiền trợ cấp đều đặn về cho mẹ nuôi ở quê nhà.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u29_3",
          "text": "Hai người phụ nữ trao nhau cái nhìn đầy ẩn ý, một cuộc đổi vai lịch sử chính thức bắt đầu chuyển bánh không thể đảo ngược.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1246.88,
      "source_end": 1291.41,
      "visual_intent": "Diễn biến tập 1 đoạn 1247s-1291s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1247.88,
          "source_end": 1260.64,
          "weight": 1.0,
          "speech_unit_id": "u29_1"
        },
        {
          "source_start": 1262.06,
          "source_end": 1274.82,
          "weight": 1.0,
          "speech_unit_id": "u29_2"
        },
        {
          "source_start": 1276.23,
          "source_end": 1288.99,
          "weight": 1.0,
          "speech_unit_id": "u29_3"
        }
      ]
    },
    {
      "id": 30,
      "narration": [
        {
          "id": "u30_1",
          "text": "Khăn voan đỏ buông xuống che khuất dung nhan diễm lệ, A Sửu bước từng bước vững chãi ra khỏi khuê phòng hướng về phía cổng lớn.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u30_2",
          "text": "Mỗi bước chân đi là một lần nàng bỏ lại sau lưng quá khứ bần hàn tăm tối để tiến về phía tương lai mịt mờ nhưng đầy hứa hẹn.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u30_3",
          "text": "Tiếng pháo nổ giòn giã ngoài ngõ hòa cùng tiếng reo hò của đám đông đứng xem náo nhiệt dọc hai bên đường cái quan.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1291.41,
      "source_end": 1335.94,
      "visual_intent": "Diễn biến tập 1 đoạn 1291s-1336s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1292.41,
          "source_end": 1305.17,
          "weight": 1.0,
          "speech_unit_id": "u30_1"
        },
        {
          "source_start": 1306.59,
          "source_end": 1319.35,
          "weight": 1.0,
          "speech_unit_id": "u30_2"
        },
        {
          "source_start": 1320.76,
          "source_end": 1333.52,
          "weight": 1.0,
          "speech_unit_id": "u30_3"
        }
      ]
    },
    {
      "id": 31,
      "narration": [
        {
          "id": "u31_1",
          "text": "Chiếc kiệu hoa tám người khiêng lộng lẫy thêu rồng phượng nâng bổng nàng tân nương lên không trung trong sự kính cẩn của đoàn tùy tùng.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u31_2",
          "text": "Phía sau là hàng trăm rương hòm của cải sính lễ trải dài đúng mười dặm như lời hứa son sắt của Lão phu nhân dòng họ Thừa An Bá.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u31_3",
          "text": "Người dân kinh thành đổ xô ra đường trầm trồ thán phục trước độ chịu chơi và gia thế hiển hách của mối lương duyên danh gia vọng tộc.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1335.94,
      "source_end": 1380.47,
      "visual_intent": "Diễn biến tập 1 đoạn 1336s-1380s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1336.94,
          "source_end": 1349.7,
          "weight": 1.0,
          "speech_unit_id": "u31_1"
        },
        {
          "source_start": 1351.12,
          "source_end": 1363.88,
          "weight": 1.0,
          "speech_unit_id": "u31_2"
        },
        {
          "source_start": 1365.29,
          "source_end": 1378.05,
          "weight": 1.0,
          "speech_unit_id": "u31_3"
        }
      ]
    },
    {
      "id": 32,
      "narration": [
        {
          "id": "u32_1",
          "text": "Người ngoài nhìn vào cứ ngỡ đây là đám cưới thế kỷ trong mơ, đâu ai ngờ bên trong kiệu hoa là một cú lừa ngoạn mục thế kỷ.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u32_2",
          "text": "Cô dâu thật thì đang trốn trong phủ uống trà ăn bánh, còn cô dâu giả thì đang ngồi thẳng lưng chuẩn bị vào hang cọp bắt cọp con.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u32_3",
          "text": "A Sửu khẽ vén một góc rèm kiệu nhìn ra phố xá tấp nập, tự nhủ lòng mình nhất định phải sống sót trở về trong vinh quang rực rỡ.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1380.47,
      "source_end": 1425.0,
      "visual_intent": "Diễn biến tập 1 đoạn 1380s-1425s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1381.47,
          "source_end": 1394.23,
          "weight": 1.0,
          "speech_unit_id": "u32_1"
        },
        {
          "source_start": 1395.65,
          "source_end": 1408.41,
          "weight": 1.0,
          "speech_unit_id": "u32_2"
        },
        {
          "source_start": 1409.82,
          "source_end": 1422.58,
          "weight": 1.0,
          "speech_unit_id": "u32_3"
        }
      ]
    },
    {
      "id": 33,
      "narration": [
        {
          "id": "u33_1",
          "text": "Đoàn rước dâu dần dần tiến về phía phủ Anh Quốc Công uy nghiêm, nơi cánh cổng sắt sơn son khổng lồ đang từ từ mở rộng đón khách.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u33_2",
          "text": "Không khí ở đây tĩnh mịch và trang nghiêm hơn hẳn, không có tiếng cười đùa rộn rã mà chỉ thoang thoảng mùi thuốc bắc nồng nặc trong gió.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u33_3",
          "text": "Dấu hiệu cho thấy tình trạng nguy kịch của vị thế tử nằm bên trong đúng là không hề được phóng đại một chút nào cả.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1425.0,
      "source_end": 1469.53,
      "visual_intent": "Diễn biến tập 1 đoạn 1425s-1470s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1426.0,
          "source_end": 1438.76,
          "weight": 1.0,
          "speech_unit_id": "u33_1"
        },
        {
          "source_start": 1440.18,
          "source_end": 1452.94,
          "weight": 1.0,
          "speech_unit_id": "u33_2"
        },
        {
          "source_start": 1454.35,
          "source_end": 1467.11,
          "weight": 1.0,
          "speech_unit_id": "u33_3"
        }
      ]
    },
    {
      "id": 34,
      "narration": [
        {
          "id": "u34_1",
          "text": "Kiệu hoa hạ xuống trước bậc tam cấp thềm rồng, bà mối đỡ tân nương bước qua chậu than hồng rực lửa theo phong tục xua đuổi tà ma xui xẻo.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u34_2",
          "text": "Từng nghi lễ bái đường được cử hành nhanh chóng và gấp gáp dưới sự chứng kiến của các vị bô lão và quan khách hai họ môn đăng hộ đối.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u34_3",
          "text": "Tất cả đều nơm nớp lo sợ thế tử tắt thở giữa chừng thì đám cưới biến thành đám tang ngay trong nháy mắt đầy bi thảm.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1469.53,
      "source_end": 1514.06,
      "visual_intent": "Diễn biến tập 1 đoạn 1470s-1514s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1470.53,
          "source_end": 1483.29,
          "weight": 1.0,
          "speech_unit_id": "u34_1"
        },
        {
          "source_start": 1484.71,
          "source_end": 1497.47,
          "weight": 1.0,
          "speech_unit_id": "u34_2"
        },
        {
          "source_start": 1498.88,
          "source_end": 1511.64,
          "weight": 1.0,
          "speech_unit_id": "u34_3"
        }
      ]
    },
    {
      "id": 35,
      "narration": [
        {
          "id": "u35_1",
          "text": "A Sửu được đưa thẳng vào phòng tân hôn u tối, nơi chiếc giường gỗ lim chạm khắc tinh xảo đang buông rèm lụa dày đặc.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u35_2",
          "text": "Trên giường, một chàng trai tuấn tú với gương mặt góc cạnh đang nằm bất động, sắc mặt nhợt nhạt không một giọt máu tươi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u35_3",
          "text": "Đó chính là Lục Trạc, vị chiến thần lẫy lừng sa trường nay lại phải chịu cảnh nằm liệt một chỗ chờ ngày số mệnh an bài.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1514.06,
      "source_end": 1558.59,
      "visual_intent": "Diễn biến tập 1 đoạn 1514s-1559s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1515.06,
          "source_end": 1527.82,
          "weight": 1.0,
          "speech_unit_id": "u35_1"
        },
        {
          "source_start": 1529.24,
          "source_end": 1542.0,
          "weight": 1.0,
          "speech_unit_id": "u35_2"
        },
        {
          "source_start": 1543.41,
          "source_end": 1556.17,
          "weight": 1.0,
          "speech_unit_id": "u35_3"
        }
      ]
    },
    {
      "id": 36,
      "narration": [
        {
          "id": "u36_1",
          "text": "Gia nhân và bà mối sau khi hoàn tất các thủ tục giao bôi hình thức liền vội vã lui hết ra ngoài, khóa chặt then cửa phòng lại.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u36_2",
          "text": "Căn phòng tân hôn rộng lớn giờ đây chỉ còn lại hai con người xa lạ, một người hôn mê bất tỉnh và một người mang thân phận giả mạo.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u36_3",
          "text": "A Sửu tự tay vén chiếc khăn voan đỏ thêu phượng, thở phào nhẹ nhõm một hơi dài sau chuỗi giờ phút căng thẳng đến nghẹt thở.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1558.59,
      "source_end": 1603.12,
      "visual_intent": "Diễn biến tập 1 đoạn 1559s-1603s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1559.59,
          "source_end": 1572.35,
          "weight": 1.0,
          "speech_unit_id": "u36_1"
        },
        {
          "source_start": 1573.77,
          "source_end": 1586.53,
          "weight": 1.0,
          "speech_unit_id": "u36_2"
        },
        {
          "source_start": 1587.94,
          "source_end": 1600.7,
          "weight": 1.0,
          "speech_unit_id": "u36_3"
        }
      ]
    },
    {
      "id": 37,
      "narration": [
        {
          "id": "u37_1",
          "text": "Nàng tiến lại gần bàn trà, thong thả rót nước và bốc ngay một miếng bánh ngọt đưa vào miệng nhai ngon lành để lót dạ sau một ngày nhịn đói.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u37_2",
          "text": "Vừa ăn nàng vừa nhìn ngắm vị phu quân trên danh nghĩa, thầm nghĩ chàng thế tử này đẹp trai phong độ thế này mà chết yểu thì phí của trời quá.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u37_3",
          "text": "Dù sao thì việc xung hỷ cũng đã xong, nàng chỉ việc diễn tròn vai một người vợ hiền thảo để chờ ngày mẹ nuôi bình phục hoàn toàn.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1603.12,
      "source_end": 1647.66,
      "visual_intent": "Diễn biến tập 1 đoạn 1603s-1648s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1604.12,
          "source_end": 1616.88,
          "weight": 1.0,
          "speech_unit_id": "u37_1"
        },
        {
          "source_start": 1618.3,
          "source_end": 1631.06,
          "weight": 1.0,
          "speech_unit_id": "u37_2"
        },
        {
          "source_start": 1632.48,
          "source_end": 1645.24,
          "weight": 1.0,
          "speech_unit_id": "u37_3"
        }
      ]
    },
    {
      "id": 38,
      "narration": [
        {
          "id": "u38_1",
          "text": "Nhưng đúng lúc A Sửu tiến lại gần mép giường định chỉnh lại chăn ấm cho phu quân, một bàn tay lạnh ngắt bất ngờ chộp lấy cổ tay nàng.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u38_2",
          "text": "Lực nắm mạnh như gọng kìm khiến nàng giật thót tim đánh rơi cả chiếc khăn tay thêu hoa sen xuống đất.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u38_3",
          "text": "Đôi mắt sâu thẳm của Lục Trạc khẽ mở ra, ánh nhìn sắc bén như lưỡi gươm báu lập tức chiếu thẳng vào khuôn mặt của nàng tân nương.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1647.66,
      "source_end": 1692.19,
      "visual_intent": "Diễn biến tập 1 đoạn 1648s-1692s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1648.66,
          "source_end": 1661.42,
          "weight": 1.0,
          "speech_unit_id": "u38_1"
        },
        {
          "source_start": 1662.84,
          "source_end": 1675.6,
          "weight": 1.0,
          "speech_unit_id": "u38_2"
        },
        {
          "source_start": 1677.01,
          "source_end": 1689.77,
          "weight": 1.0,
          "speech_unit_id": "u38_3"
        }
      ]
    },
    {
      "id": 39,
      "narration": [
        {
          "id": "u39_1",
          "text": "Chàng thế tử tưởng chừng sắp đi gặp tổ tiên nay lại thần kỳ hồi tỉnh ngay trong đêm tân hôn định mệnh đầu tiên.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u39_2",
          "text": "Khí tức lạnh lẽo bao trùm khắp căn phòng khi chàng cất giọng khàn đặc hỏi rằng nàng rốt cuộc là ai và do ai phái đến đây ám hại chàng.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u39_3",
          "text": "A Sửu sững sờ trong giây lát, nhưng bản năng sinh tồn mãnh liệt của một cô gái lăn lộn giang hồ lập tức phát huy tác dụng kịp thời.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1692.19,
      "source_end": 1736.72,
      "visual_intent": "Diễn biến tập 1 đoạn 1692s-1737s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1693.19,
          "source_end": 1705.95,
          "weight": 1.0,
          "speech_unit_id": "u39_1"
        },
        {
          "source_start": 1707.37,
          "source_end": 1720.13,
          "weight": 1.0,
          "speech_unit_id": "u39_2"
        },
        {
          "source_start": 1721.54,
          "source_end": 1734.3,
          "weight": 1.0,
          "speech_unit_id": "u39_3"
        }
      ]
    },
    {
      "id": 40,
      "narration": [
        {
          "id": "u40_1",
          "text": "Nàng không hề luống cuống run rẩy, trái lại nhẹ nhàng đỡ chàng ngồi dựa vào thành giường và rót ngay một chén nước ấm đưa tới tận miệng.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u40_2",
          "text": "Nàng từ tốn đáp rằng thiếp là thê tử hợp pháp được Thừa An Bá phủ gả sang để chăm sóc chàng, xin thế tử bớt giận giữ gìn long thể.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u40_3",
          "text": "Sự bình thản và điềm tĩnh khác thường của nàng thê tử mới cưới khiến vị thế tử đa nghi bắt đầu dấy lên mối hoài nghi sâu sắc trong lòng.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1736.72,
      "source_end": 1781.25,
      "visual_intent": "Diễn biến tập 1 đoạn 1737s-1781s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1737.72,
          "source_end": 1750.48,
          "weight": 1.0,
          "speech_unit_id": "u40_1"
        },
        {
          "source_start": 1751.9,
          "source_end": 1764.66,
          "weight": 1.0,
          "speech_unit_id": "u40_2"
        },
        {
          "source_start": 1766.07,
          "source_end": 1778.83,
          "weight": 1.0,
          "speech_unit_id": "u40_3"
        }
      ]
    },
    {
      "id": 41,
      "narration": [
        {
          "id": "u41_1",
          "text": "Lục Trạc uống cạn chén nước ấm, ánh mắt vẫn không rời khỏi từng nét mặt và biểu cảm nhỏ nhất của người con gái đang đứng trước mặt mình.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u41_2",
          "text": "Chàng nhận ra đôi bàn tay của nàng tuy được bôi phấn trắng mịn nhưng khớp ngón tay lại có vết chai sạn của người từng lao động vất vả lâu năm.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u41_3",
          "text": "Một thiên kim tiểu thư sống trong nhung lụa ăn sung mặc sướng từ nhỏ tuyệt đối không thể nào có đôi bàn tay chai sần như thế này được.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1781.25,
      "source_end": 1825.78,
      "visual_intent": "Diễn biến tập 1 đoạn 1781s-1826s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1782.25,
          "source_end": 1795.01,
          "weight": 1.0,
          "speech_unit_id": "u41_1"
        },
        {
          "source_start": 1796.43,
          "source_end": 1809.19,
          "weight": 1.0,
          "speech_unit_id": "u41_2"
        },
        {
          "source_start": 1810.6,
          "source_end": 1823.36,
          "weight": 1.0,
          "speech_unit_id": "u41_3"
        }
      ]
    },
    {
      "id": 42,
      "narration": [
        {
          "id": "u42_1",
          "text": "A Sửu tinh ý nhận ra chàng đang soi xét bàn tay mình, liền nhanh trí giả vờ ngượng ngùng giấu tay vào trong ống tay áo rộng thùng thình.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u42_2",
          "text": "Nàng chống chế rằng dạo gần đây nàng thường xuyên chép kinh Phật và thêu khăn tay cầu nguyện cho thế tử nên ngón tay mới bị chai như vậy.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u42_3",
          "text": "Lý do nghe thì có vẻ hợp lý và tràn ngập tình nghĩa phu thê, nhưng trong bụng chàng thế tử thì thừa biết nàng đang bốc phét không chớp mắt.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1825.78,
      "source_end": 1870.31,
      "visual_intent": "Diễn biến tập 1 đoạn 1826s-1870s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1826.78,
          "source_end": 1839.54,
          "weight": 1.0,
          "speech_unit_id": "u42_1"
        },
        {
          "source_start": 1840.96,
          "source_end": 1853.72,
          "weight": 1.0,
          "speech_unit_id": "u42_2"
        },
        {
          "source_start": 1855.13,
          "source_end": 1867.89,
          "weight": 1.0,
          "speech_unit_id": "u42_3"
        }
      ]
    },
    {
      "id": 43,
      "narration": [
        {
          "id": "u43_1",
          "text": "Bên ngoài cửa sổ, bóng của một tỳ nữ thân tín do phủ Anh Quốc Công cài cắm đang lén lút dòm ngó nghe ngóng động tĩnh bên trong.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u43_2",
          "text": "Nhận thấy có kẻ rình rập, Lục Trạc bất ngờ kéo mạnh A Sửu ngã vào lòng mình trên chiếc giường hỷ phủ đầy cánh hoa hồng thơm ngát.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u43_3",
          "text": "Hành động táo bạo và bất ngờ của phu quân khiến A Sửu đỏ bừng mặt, tim đập thình thịch như đánh trống trận trong lồng ngực.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1870.31,
      "source_end": 1914.84,
      "visual_intent": "Diễn biến tập 1 đoạn 1870s-1915s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1871.31,
          "source_end": 1884.07,
          "weight": 1.0,
          "speech_unit_id": "u43_1"
        },
        {
          "source_start": 1885.49,
          "source_end": 1898.25,
          "weight": 1.0,
          "speech_unit_id": "u43_2"
        },
        {
          "source_start": 1899.66,
          "source_end": 1912.42,
          "weight": 1.0,
          "speech_unit_id": "u43_3"
        }
      ]
    },
    {
      "id": 44,
      "narration": [
        {
          "id": "u44_1",
          "text": "Chàng ghé sát tai nàng thì thầm ra lệnh rằng hãy phối hợp diễn một màn kịch ân ái mặn nồng để đánh lạc hướng tai mắt của kẻ thù xung quanh.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u44_2",
          "text": "Hiểu được tình thế nguy hiểm ngàn cân treo sợi tóc, A Sửu lập tức hùa theo, cất tiếng nũng nịu ngọt ngào như rót mật vào tai chàng thế tử.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u44_3",
          "text": "Kẻ theo dõi bên ngoài nghe thấy động tĩnh thân mật liền vội vã rút lui trong đêm để về bẩm báo lại cho chủ mưu đứng sau giật dây.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1914.84,
      "source_end": 1959.38,
      "visual_intent": "Diễn biến tập 1 đoạn 1915s-1959s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1915.84,
          "source_end": 1928.6,
          "weight": 1.0,
          "speech_unit_id": "u44_1"
        },
        {
          "source_start": 1930.02,
          "source_end": 1942.78,
          "weight": 1.0,
          "speech_unit_id": "u44_2"
        },
        {
          "source_start": 1944.2,
          "source_end": 1956.96,
          "weight": 1.0,
          "speech_unit_id": "u44_3"
        }
      ]
    },
    {
      "id": 45,
      "narration": [
        {
          "id": "u45_1",
          "text": "Khi kẻ địch đã đi xa, hai người lập tức tách nhau ra giữ khoảng cách an toàn, ánh mắt nhìn nhau chứa chan sự đề phòng và tính toán sâu xa.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u45_2",
          "text": "Một liên minh bất đắc dĩ giữa chàng thế tử trùng sinh hồi phục và nàng thiên kim giả mạo xuất thân đáy xã hội chính thức được thiết lập.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u45_3",
          "text": "Cả hai đều có những bí mật động trời cần che giấu và những kẻ thù nguy hiểm đang rình rập muốn dồn họ vào chỗ chết không toàn thây.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 1959.38,
      "source_end": 2003.91,
      "visual_intent": "Diễn biến tập 1 đoạn 1959s-2004s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 1960.38,
          "source_end": 1973.14,
          "weight": 1.0,
          "speech_unit_id": "u45_1"
        },
        {
          "source_start": 1974.56,
          "source_end": 1987.32,
          "weight": 1.0,
          "speech_unit_id": "u45_2"
        },
        {
          "source_start": 1988.73,
          "source_end": 2001.49,
          "weight": 1.0,
          "speech_unit_id": "u45_3"
        }
      ]
    },
    {
      "id": 46,
      "narration": [
        {
          "id": "u46_1",
          "text": "Cùng lúc đó tại Thừa An Bá phủ, Quân Đại sau khi trút được gánh nặng hôn sự xung hỷ thì đang ung dung ngồi thưởng thức trà thơm bánh ngọt.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u46_2",
          "text": "Ả ta đắc ý cho rằng nước cờ của mình quá hoàn hảo, vừa giữ được thanh xuân trinh trắng vừa đuổi được kẻ có gương mặt giống mình đi xa xứ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u46_3",
          "text": "Nhưng người tính không bằng trời tính, ả không thể ngờ rằng việc đẩy A Sửu đi chính là nhát dao tự chặt đứt vận mệnh tương lai của chính mình.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2003.91,
      "source_end": 2048.44,
      "visual_intent": "Diễn biến tập 1 đoạn 2004s-2048s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2004.91,
          "source_end": 2017.67,
          "weight": 1.0,
          "speech_unit_id": "u46_1"
        },
        {
          "source_start": 2019.09,
          "source_end": 2031.85,
          "weight": 1.0,
          "speech_unit_id": "u46_2"
        },
        {
          "source_start": 2033.26,
          "source_end": 2046.02,
          "weight": 1.0,
          "speech_unit_id": "u46_3"
        }
      ]
    },
    {
      "id": 47,
      "narration": [
        {
          "id": "u47_1",
          "text": "Trong căn phòng thờ gia tộc u ám, Bá phu nhân quỳ sụp trước bài vị tổ tiên khóc lóc thảm thiết vì nỗi dằn vặt tội lỗi bao năm chôn giấu.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u47_2",
          "text": "Ký ức mười sáu năm trước hiện về như một cuốn phim quay chậm: cảnh tượng tráo đổi hai đứa trẻ sơ sinh trong một đêm mưa gió bão bùng.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u47_3",
          "text": "Đứa trẻ mang dòng máu chính thống của Thừa An Bá phủ thực chất chính là Ngụy Nhiêu, tức A Sửu cô gái dọn đêm nghèo khổ ngày nay.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2048.44,
      "source_end": 2092.97,
      "visual_intent": "Diễn biến tập 1 đoạn 2048s-2093s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2049.44,
          "source_end": 2062.2,
          "weight": 1.0,
          "speech_unit_id": "u47_1"
        },
        {
          "source_start": 2063.62,
          "source_end": 2076.38,
          "weight": 1.0,
          "speech_unit_id": "u47_2"
        },
        {
          "source_start": 2077.79,
          "source_end": 2090.55,
          "weight": 1.0,
          "speech_unit_id": "u47_3"
        }
      ]
    },
    {
      "id": 48,
      "narration": [
        {
          "id": "u48_1",
          "text": "Còn Quân Đại, đứa con gái được cưng chiều như ngọc như ngà bao năm qua thực chất chỉ là đứa con hoang của bà cô bên ngoại tráo vào nhận vơ danh phận.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u48_2",
          "text": "Bá phu nhân run rẩy lo sợ một ngày nào đó sự thật bị phơi bày ra ánh sáng, gia tộc sẽ tan nát và bản thân bà sẽ không còn mặt mũi nào nhìn tổ tiên.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u48_3",
          "text": "Bi kịch trớ trêu thay khi chính tay kẻ giả mạo lại tống khứ người thừa kế hợp pháp chân chính vào vòng tay của vị thế tử quyền lực nhất thiên hạ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2092.97,
      "source_end": 2137.5,
      "visual_intent": "Diễn biến tập 1 đoạn 2093s-2138s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2093.97,
          "source_end": 2106.73,
          "weight": 1.0,
          "speech_unit_id": "u48_1"
        },
        {
          "source_start": 2108.15,
          "source_end": 2120.91,
          "weight": 1.0,
          "speech_unit_id": "u48_2"
        },
        {
          "source_start": 2122.32,
          "source_end": 2135.08,
          "weight": 1.0,
          "speech_unit_id": "u48_3"
        }
      ]
    },
    {
      "id": 49,
      "narration": [
        {
          "id": "u49_1",
          "text": "Đúng là người tính không bằng trời tính, tưởng đâu đẩy người ta vào chỗ chết ai ngờ lại tạo cơ hội cho chân phụng hoàng tái sinh từ tro tàn.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u49_2",
          "text": "Khán giả xem đến đây chỉ biết vỗ đùi đánh đét vì màn biên kịch quay xe quá gắt, quả báo đến muộn nhưng chắc chắn sẽ đến nơi đến chốn.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u49_3",
          "text": "Tập 1 kết thúc việc thiết lập bàn cờ một cách xuất sắc, mở đường cho những màn cung đấu trả thù rực lửa ở những tập tiếp theo.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2137.5,
      "source_end": 2182.03,
      "visual_intent": "Diễn biến tập 1 đoạn 2138s-2182s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2138.5,
          "source_end": 2151.26,
          "weight": 1.0,
          "speech_unit_id": "u49_1"
        },
        {
          "source_start": 2152.68,
          "source_end": 2165.44,
          "weight": 1.0,
          "speech_unit_id": "u49_2"
        },
        {
          "source_start": 2166.85,
          "source_end": 2179.61,
          "weight": 1.0,
          "speech_unit_id": "u49_3"
        }
      ]
    },
    {
      "id": 50,
      "narration": [
        {
          "id": "u50_1",
          "text": "Sáng hôm sau, tin tức thế tử Anh Quốc Công hồi tỉnh thần kỳ sau đêm tân hôn lập tức lan truyền khắp toàn bộ kinh thành như một cơn lốc xoáy.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u50_2",
          "text": "Ai nấy đều trầm trồ ca tụng nhị tiểu thư Thừa An Bá phủ quả nhiên mang số mệnh đại cát đại lợi, vừa bước vào cửa là mang lại sinh khí dồi dào.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u50_3",
          "text": "Tin lành bay về Thừa An Bá phủ khiến Quân Đại đang ăn điểm tâm nghe xong mà sặc trà suýt nghẹn chết vì kinh hoàng tột độ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2182.03,
      "source_end": 2226.56,
      "visual_intent": "Diễn biến tập 1 đoạn 2182s-2227s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2183.03,
          "source_end": 2195.79,
          "weight": 1.0,
          "speech_unit_id": "u50_1"
        },
        {
          "source_start": 2197.21,
          "source_end": 2209.97,
          "weight": 1.0,
          "speech_unit_id": "u50_2"
        },
        {
          "source_start": 2211.38,
          "source_end": 2224.14,
          "weight": 1.0,
          "speech_unit_id": "u50_3"
        }
      ]
    },
    {
      "id": 51,
      "narration": [
        {
          "id": "u51_1",
          "text": "Ả ta bàng hoàng nhận ra mình vừa tự tay dâng tặng vị trí thế tử phi quyền quý và người chồng đẹp trai tài giỏi cho một đứa dọn đêm hèn hạ.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u51_2",
          "text": "Cơn ghen tức và hối hận trào dâng trong lòng khiến Quân Đại phát điên, lập tức toan tính mưu kế mới để tìm cách lật tẩy và triệt hạ A Sửu.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u51_3",
          "text": "Từ vị thế kẻ chủ động ban phát số phận, nay ả ta đã biến thành kẻ thua cuộc nơm nớp lo sợ bị lật ngược tình thế bất cứ lúc nào.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2226.56,
      "source_end": 2271.09,
      "visual_intent": "Diễn biến tập 1 đoạn 2227s-2271s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2227.56,
          "source_end": 2240.32,
          "weight": 1.0,
          "speech_unit_id": "u51_1"
        },
        {
          "source_start": 2241.74,
          "source_end": 2254.5,
          "weight": 1.0,
          "speech_unit_id": "u51_2"
        },
        {
          "source_start": 2255.91,
          "source_end": 2268.67,
          "weight": 1.0,
          "speech_unit_id": "u51_3"
        }
      ]
    },
    {
      "id": 52,
      "narration": [
        {
          "id": "u52_1",
          "text": "Trong khi đó tại Anh Quốc Công phủ, A Sửu bắt đầu đón nhận sự kính trọng từ gia nhân và sự chào đón nồng nhiệt của các bậc trưởng bối trong phủ.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u52_2",
          "text": "Nàng không hề tự mãn hay kiêu ngạo, trái lại vẫn giữ thái độ khiêm nhường, cẩn trọng trong từng lời ăn tiếng nói và cử chỉ thường nhật.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u52_3",
          "text": "Sự khôn ngoan và tinh tế của nàng nhanh chóng chiếm trọn cảm tình của Lão phu nhân nhà chồng, củng cố vững chắc vị thế trong gia tộc.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2271.09,
      "source_end": 2315.62,
      "visual_intent": "Diễn biến tập 1 đoạn 2271s-2316s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2272.09,
          "source_end": 2284.85,
          "weight": 1.0,
          "speech_unit_id": "u52_1"
        },
        {
          "source_start": 2286.27,
          "source_end": 2299.03,
          "weight": 1.0,
          "speech_unit_id": "u52_2"
        },
        {
          "source_start": 2300.44,
          "source_end": 2313.2,
          "weight": 1.0,
          "speech_unit_id": "u52_3"
        }
      ]
    },
    {
      "id": 53,
      "narration": [
        {
          "id": "u53_1",
          "text": "Lục Trạc quan sát người vợ mới cưới suốt cả ngày trời, càng nhìn càng nhận thấy nàng có khí chất bất phàm và bản lĩnh kiên cường hiếm có.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u53_2",
          "text": "Chàng biết thân thế của nàng chắc chắn có uẩn khúc lớn, nhưng tạm thời chàng quyết định giữ im lặng để xem nàng sẽ diễn tiếp màn kịch này ra sao.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u53_3",
          "text": "Mối quan hệ giữa hai người dần chuyển từ đối đầu nghi ngờ sang sự tôn trọng và thấu hiểu ngầm trong từng ánh mắt trao nhau.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2315.62,
      "source_end": 2360.16,
      "visual_intent": "Diễn biến tập 1 đoạn 2316s-2360s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2316.62,
          "source_end": 2329.38,
          "weight": 1.0,
          "speech_unit_id": "u53_1"
        },
        {
          "source_start": 2330.8,
          "source_end": 2343.56,
          "weight": 1.0,
          "speech_unit_id": "u53_2"
        },
        {
          "source_start": 2344.98,
          "source_end": 2357.74,
          "weight": 1.0,
          "speech_unit_id": "u53_3"
        }
      ]
    },
    {
      "id": 54,
      "narration": [
        {
          "id": "u54_1",
          "text": "Những dòng người tấp nập kéo đến chúc mừng đôi tân lang tân nương mang lại sinh khí rộn ràng khắp phủ đệ sau chuỗi ngày ảm đạm dài dằng dặc.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u54_2",
          "text": "Nhạc hỷ lại một lần nữa trỗi khúc hân hoan, báo hiệu một chương mới rực rỡ sắp sửa mở ra cho số phận của cô gái từng mang tên A Sửu.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u54_3",
          "text": "Từ đáy bùn đen xã hội bước lên đỉnh cao danh vọng, hành trình của nàng chỉ mới bắt đầu nhưng đã mang đầy dáng dấp của một truyền kỳ.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2360.16,
      "source_end": 2404.69,
      "visual_intent": "Diễn biến tập 1 đoạn 2360s-2405s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2361.16,
          "source_end": 2373.92,
          "weight": 1.0,
          "speech_unit_id": "u54_1"
        },
        {
          "source_start": 2375.34,
          "source_end": 2388.1,
          "weight": 1.0,
          "speech_unit_id": "u54_2"
        },
        {
          "source_start": 2389.51,
          "source_end": 2402.27,
          "weight": 1.0,
          "speech_unit_id": "u54_3"
        }
      ]
    },
    {
      "id": 55,
      "narration": [
        {
          "id": "u55_1",
          "text": "Cái giá của chiếc trâm vàng năm xưa nay đã được quy đổi bằng cả một cuộc đời mới, nơi kẻ ác phải run sợ còn người lương thiện được đền đáp.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u55_2",
          "text": "Quân Đại đứng từ xa nhìn cỗ xe ngựa quyền quý đi qua mà cắn nát môi dưới, chính thức tuyên chiến trong bóng tối với người chị em sinh đôi.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u55_3",
          "text": "Cuộc chiến sinh tử giữa hai đóa hoa song sinh cùng chung gương mặt nhưng khác biệt tâm can hứa hẹn sẽ làm nổ tung màn ảnh trong các tập tiếp theo.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2404.69,
      "source_end": 2449.22,
      "visual_intent": "Diễn biến tập 1 đoạn 2405s-2449s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2405.69,
          "source_end": 2418.45,
          "weight": 1.0,
          "speech_unit_id": "u55_1"
        },
        {
          "source_start": 2419.87,
          "source_end": 2432.63,
          "weight": 1.0,
          "speech_unit_id": "u55_2"
        },
        {
          "source_start": 2434.04,
          "source_end": 2446.8,
          "weight": 1.0,
          "speech_unit_id": "u55_3"
        }
      ]
    },
    {
      "id": 56,
      "narration": [
        {
          "id": "u56_1",
          "text": "Tập 1 của Gả Kim Thoa khép lại bằng phân cảnh Lục Trạc mỉm cười đưa tay đỡ A Sửu bước xuống bậc thềm trước sự chứng kiến của toàn thể bá quan.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u56_2",
          "text": "Ánh nắng ban mai rực rỡ chiếu rọi lên tà áo đỏ thêu hoa phượng của nàng thế tử phi mới, rạng ngời và kiêu hãnh như một nữ vương thực thụ.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u56_3",
          "text": "Một cái kết không thể nào viên mãn hơn cho tập mở màn, vừa thỏa mãn tâm lý người xem vừa gieo rắc vô số sự tò mò háo hức khôn nguôi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2449.22,
      "source_end": 2493.75,
      "visual_intent": "Diễn biến tập 1 đoạn 2449s-2494s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2450.22,
          "source_end": 2462.98,
          "weight": 1.0,
          "speech_unit_id": "u56_1"
        },
        {
          "source_start": 2464.4,
          "source_end": 2477.16,
          "weight": 1.0,
          "speech_unit_id": "u56_2"
        },
        {
          "source_start": 2478.57,
          "source_end": 2491.33,
          "weight": 1.0,
          "speech_unit_id": "u56_3"
        }
      ]
    },
    {
      "id": 57,
      "narration": [
        {
          "id": "u57_1",
          "text": "Tiếng hát hào hùng đầy bi tráng của bài ca chủ đề Tá Danh Nhập Cục do Lưu Vũ Ninh thể hiện vang lên đưa tập phim dần đi vào hồi kết.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u57_2",
          "text": "Từng lời ca da diết như khắc họa trọn vẹn số phận nghiệt ngã của những kiếp người tráo đổi thân phận trong vòng xoáy quyền mưu tranh đoạt.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u57_3",
          "text": "Một bộ phim cổ trang cung đấu xuất sắc hiếm hoi của năm nay mà mọt phim chân chính tuyệt đối không nên bỏ lỡ dù chỉ một giây.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2493.75,
      "source_end": 2538.28,
      "visual_intent": "Diễn biến tập 1 đoạn 2494s-2538s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2494.75,
          "source_end": 2507.51,
          "weight": 1.0,
          "speech_unit_id": "u57_1"
        },
        {
          "source_start": 2508.93,
          "source_end": 2521.69,
          "weight": 1.0,
          "speech_unit_id": "u57_2"
        },
        {
          "source_start": 2523.1,
          "source_end": 2535.86,
          "weight": 1.0,
          "speech_unit_id": "u57_3"
        }
      ]
    },
    {
      "id": 58,
      "narration": [
        {
          "id": "u58_1",
          "text": "Trước khi bước vào phủ Anh Quốc Công, Lục Trạc vốn là vị tướng quân bách chiến bách thắng khiến quân địch khiếp sợ.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u58_2",
          "text": "Vết thương trúng tên độc trên sa trường thực chất là một âm mưu ám hại tinh vi từ chính nội bộ triều đình cài cắm.",
          "emotion": "suspense",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u58_3",
          "text": "Sự hồi tỉnh bất ngờ của chàng không chỉ làm đảo lộn kế hoạch của kẻ thù mà còn biến nàng thê tử mới cưới thành mục tiêu nhắm đến.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2538.28,
      "source_end": 2582.81,
      "visual_intent": "Diễn biến tập 1 đoạn 2538s-2583s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2539.28,
          "source_end": 2552.04,
          "weight": 1.0,
          "speech_unit_id": "u58_1"
        },
        {
          "source_start": 2553.46,
          "source_end": 2566.22,
          "weight": 1.0,
          "speech_unit_id": "u58_2"
        },
        {
          "source_start": 2567.63,
          "source_end": 2580.39,
          "weight": 1.0,
          "speech_unit_id": "u58_3"
        }
      ]
    },
    {
      "id": 59,
      "narration": [
        {
          "id": "u59_1",
          "text": "Ngay trong đêm tân hôn đầu tiên, Lục Trạc đã bí mật ra lệnh cho thuộc hạ thân tín âm thầm điều tra toàn bộ lai lịch của nàng dâu mới.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u59_2",
          "text": "Chàng nhận thấy từng hành vi cử chỉ của A Sửu tuy rất mực đoan trang nhưng lại luôn toát lên vẻ cảnh giác cao độ của loài báo săn mồi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u59_3",
          "text": "Rõ ràng đây không phải là một vị tiểu thư khuê các chỉ biết cầm kỳ thi họa và ru rú trong chốn hậu phòng son rỗi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2582.81,
      "source_end": 2627.34,
      "visual_intent": "Diễn biến tập 1 đoạn 2583s-2627s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2583.81,
          "source_end": 2596.57,
          "weight": 1.0,
          "speech_unit_id": "u59_1"
        },
        {
          "source_start": 2597.99,
          "source_end": 2610.75,
          "weight": 1.0,
          "speech_unit_id": "u59_2"
        },
        {
          "source_start": 2612.16,
          "source_end": 2624.92,
          "weight": 1.0,
          "speech_unit_id": "u59_3"
        }
      ]
    },
    {
      "id": 60,
      "narration": [
        {
          "id": "u60_1",
          "text": "Về phần A Sửu, sáng sớm thức dậy nàng đã chủ động xắn tay áo vào bếp nấu một nồi canh bồi bổ thượng hạng cho phu quân đang dưỡng thương.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u60_2",
          "text": "Mùi canh thơm lừng lan tỏa khắp sân viện khiến đám đầu bếp kỳ cựu trong phủ cũng phải tròn xoe mắt thán phục tay nghề nấu nướng.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u60_3",
          "text": "Họ đâu biết rằng ở quê nhà, tài nấu nướng sinh tồn của nàng đã được tôi luyện qua hàng ngàn bữa cơm đạm bạc nuôi mẹ già.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2627.34,
      "source_end": 2671.88,
      "visual_intent": "Diễn biến tập 1 đoạn 2627s-2672s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2628.34,
          "source_end": 2641.1,
          "weight": 1.0,
          "speech_unit_id": "u60_1"
        },
        {
          "source_start": 2642.52,
          "source_end": 2655.28,
          "weight": 1.0,
          "speech_unit_id": "u60_2"
        },
        {
          "source_start": 2656.7,
          "source_end": 2669.46,
          "weight": 1.0,
          "speech_unit_id": "u60_3"
        }
      ]
    },
    {
      "id": 61,
      "narration": [
        {
          "id": "u61_1",
          "text": "Lục Trạc húp trọn bát canh nóng hổi, cảm giác luồng chân khí ấm áp lan tỏa khắp kinh mạch giúp vết thương mau chóng lành lặn.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u61_2",
          "text": "Chàng mỉm cười trêu chọc rằng không ngờ nhị tiểu thư Thừa An Bá phủ vừa giỏi làm thê tử hiền vừa có tài làm đầu bếp trứ danh.",
          "emotion": "excited",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u61_3",
          "text": "A Sửu liếc xéo một cái rồi đáp rằng nếu chàng còn dám nghi ngờ lòng dạ thiếp thì lần sau canh sẽ được nêm thêm một thìa ớt bột cay xé lưỡi.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2671.88,
      "source_end": 2716.41,
      "visual_intent": "Diễn biến tập 1 đoạn 2672s-2716s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2672.88,
          "source_end": 2685.64,
          "weight": 1.0,
          "speech_unit_id": "u61_1"
        },
        {
          "source_start": 2687.06,
          "source_end": 2699.82,
          "weight": 1.0,
          "speech_unit_id": "u61_2"
        },
        {
          "source_start": 2701.23,
          "source_end": 2713.99,
          "weight": 1.0,
          "speech_unit_id": "u61_3"
        }
      ]
    },
    {
      "id": 62,
      "narration": [
        {
          "id": "u62_1",
          "text": "Bên ngoài phủ Anh Quốc Công, các thế lực ngầm bắt đầu rục rịch chuyển động khi nghe tin vị chiến thần trẻ tuổi đã mở mắt bình phục.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u62_2",
          "text": "Những bức mật thư được bí mật chuyển đi trong đêm tối, báo hiệu một cơn bão táp cung đình chuẩn bị đổ ập xuống đầu đôi tân lang tân nương.",
          "emotion": "serious",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u62_3",
          "text": "Một cuộc đấu trí không cân sức nơi hậu viện và triều đình chính thức kéo cờ khai cuộc với những nước cờ cân não đến nghẹt thở.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2716.41,
      "source_end": 2760.94,
      "visual_intent": "Diễn biến tập 1 đoạn 2716s-2761s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2717.41,
          "source_end": 2730.17,
          "weight": 1.0,
          "speech_unit_id": "u62_1"
        },
        {
          "source_start": 2731.59,
          "source_end": 2744.35,
          "weight": 1.0,
          "speech_unit_id": "u62_2"
        },
        {
          "source_start": 2745.76,
          "source_end": 2758.52,
          "weight": 1.0,
          "speech_unit_id": "u62_3"
        }
      ]
    },
    {
      "id": 63,
      "narration": [
        {
          "id": "u63_1",
          "text": "A Sửu đứng bên cửa sổ ngắm nhìn bầu trời kinh thành lộng gió, bàn tay khẽ siết chặt chiếc khăn thêu kỷ vật mẹ nuôi trao trước ngày lên đường.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u63_2",
          "text": "Nàng thầm nhủ dù phong ba bão táp có dữ dội đến đâu, nàng cũng sẽ kiên cường đứng vững để bảo vệ gia đình và người thân yêu nhất.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u63_3",
          "text": "Ánh mắt nàng bừng sáng ngọn lửa quyết tâm, sẵn sàng đạp bằng mọi chông gai hiểm trở để viết nên thiên huyền thoại của riêng mình.",
          "emotion": "normal",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2760.94,
      "source_end": 2805.47,
      "visual_intent": "Diễn biến tập 1 đoạn 2761s-2805s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2761.94,
          "source_end": 2774.7,
          "weight": 1.0,
          "speech_unit_id": "u63_1"
        },
        {
          "source_start": 2776.12,
          "source_end": 2788.88,
          "weight": 1.0,
          "speech_unit_id": "u63_2"
        },
        {
          "source_start": 2790.29,
          "source_end": 2803.05,
          "weight": 1.0,
          "speech_unit_id": "u63_3"
        }
      ]
    },
    {
      "id": 64,
      "narration": [
        {
          "id": "u64_1",
          "text": "Chiếc trâm vàng đẫm máu năm nào từng là mồi lửa cho sự phản bội, nay lại trở thành chiếc chìa khóa mở ra cánh cửa định mệnh cho nàng.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u64_2",
          "text": "Quân Đại ngỡ mình là kẻ giăng bẫy tài ba, nhưng rốt cuộc ả ta chỉ là con rối vô tình dâng tặng cả giang sơn cho người khác.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        },
        {
          "id": "u64_3",
          "text": "Màn kết tập một quá đỗi mãn nhãn khiến người xem phải trầm trồ vỗ tay và háo hức chờ đợi những màn lật kèo nảy lửa ở tập kế tiếp.",
          "emotion": "punchline",
          "rate_percent": null,
          "pitch_hz": null,
          "volume_percent": null,
          "pause_before_ms": null,
          "pause_after_ms": null
        }
      ],
      "source_start": 2805.47,
      "source_end": 2850.0,
      "visual_intent": "Diễn biến tập 1 đoạn 2805s-2850s",
      "target_duration": null,
      "keep_original_audio": true,
      "section": "story",
      "shots": [
        {
          "source_start": 2806.47,
          "source_end": 2819.23,
          "weight": 1.0,
          "speech_unit_id": "u64_1"
        },
        {
          "source_start": 2820.65,
          "source_end": 2833.41,
          "weight": 1.0,
          "speech_unit_id": "u64_2"
        },
        {
          "source_start": 2834.82,
          "source_end": 2847.58,
          "weight": 1.0,
          "speech_unit_id": "u64_3"
        }
      ]
    },
    {
      "id": 65,
      "narration": "Tập một Gả Kim Thoa có nhịp phim nhanh gọn, mâu thuẫn thế gả thiết lập sắc nét và diễn xuất phân thân của Điền Hi Vi cực kỳ lôi cuốn. Màu phim sang trọng cùng âm nhạc hoành tráng tạo cảm giác điện ảnh rõ rệt. Đây chắc chắn là tác phẩm cổ trang gia đấu đáng xem nhất thời điểm hiện tại cho các mọt phim cung đấu.",
      "source_start": 2850.0,
      "source_end": 2912.15,
      "visual_intent": "Đánh giá tổng quan chất lượng diễn xuất, kịch bản và màu phim tập 1",
      "target_duration": null,
      "keep_original_audio": false,
      "section": "assessment",
      "shots": [
        {
          "source_start": 2855.0,
          "source_end": 2875.0,
          "weight": 1.0,
          "speech_unit_id": null
        },
        {
          "source_start": 2880.0,
          "source_end": 2905.0,
          "weight": 1.0,
          "speech_unit_id": null
        }
      ]
    }
  ]
}