# Copy to .env (never committed). run.sh, start.sh and service.sh load it.

# Dashboard
HARNESS_PORT=8790
HARNESS_HOST=127.0.0.1
# Extra Host names the dashboard accepts (comma separated), e.g. a reverse-proxy name.
# HARNESS_ALLOW_HOSTS=
# Folders the "+ Job mới" file browser may list (colon separated). Default: media/, ~/Videos, ~
# HARNESS_MEDIA_DIRS=/data/films:/home/me/Videos

# Jobs folder (default: jobs/ in the harness)
# HARNESS_JOBS_DIR=/data/review-jobs

# FFmpeg override (default: .tools/conda/bin, then PATH)
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe
