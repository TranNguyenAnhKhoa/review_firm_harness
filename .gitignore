# Local runtimes and caches (./setup.sh recreates them)
.venv/
.tools/
models/
.run/
__pycache__/
*.pyc
.pytest_cache/
.env

# Source films live outside git (put them in media/ or anywhere and point the job at them)
media/*
!media/.gitkeep
*.mp4
*.mkv
*.mov
*.avi
*.ts
*.wav
*.mp3
*.m4a

# Jobs are local data. Only the job migrated from the Windows version is tracked (text + keyframes).
jobs/*
!jobs/.gitkeep
!jobs/ga_kim_thoa_ep01/
jobs/ga_kim_thoa_ep01/*
!jobs/ga_kim_thoa_ep01/job.json
!jobs/ga_kim_thoa_ep01/state.json
!jobs/ga_kim_thoa_ep01/events.jsonl
!jobs/ga_kim_thoa_ep01/02_read/
jobs/ga_kim_thoa_ep01/02_read/*
!jobs/ga_kim_thoa_ep01/02_read/timeline.md
!jobs/ga_kim_thoa_ep01/02_read/keyframes/
!jobs/ga_kim_thoa_ep01/03_write/
jobs/ga_kim_thoa_ep01/03_write/*
!jobs/ga_kim_thoa_ep01/03_write/review.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
