# ==========================================
# Review Firm Harness .gitignore
# ==========================================

# Video assets (Raw movies & rendered clips - strictly excluded)
SrcVideo/
input/videos/
*.mp4
*.mkv
*.mov
*.avi
*.ts

# Output & Render cache
output/
tmp/
temp/
cache/
data/handoff/*/work/
data/handoff/*/probe/
**/output/
**/cache/
**/tmp/

# Audio artifacts
*.wav
*.pcm
*.flac
*.mp3
!examples/**/*.mp3

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Binary tools & Models
.tools/
data/models/
ZeroTTS/
analysis_1004/models/
analysis_1004/packages/
analysis_1004/*.wav
analysis_1004/*.mp3
*.exe
*.dll

# Local Scratch, Audits & Non-code assets
C-drive-app-audit-2026-10-11/
hermes-agent/
ảnh/
*.docx

# Logs & Editor caches
*.log
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
